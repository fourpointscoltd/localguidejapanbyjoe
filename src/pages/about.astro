---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <main class="gh-main">
    <article class="gh-article">
      <header class="gh-article-header gh-canvas">
        <h1 class="gh-article-title">About</h1>
      </header>

      <section class="gh-content gh-canvas">
        <p>Welcome to our blog. We share insights, stories, and ideas about technology, design, and creativity.</p>

        <h2>Our Mission</h2>
        <p>We believe in the power of sharing knowledge. Our goal is to create content that inspires, educates, and helps you grow.</p>

        <h2>Get in Touch</h2>
        <p>Have questions or want to collaborate? Feel free to reach out through our contact page or social media channels.</p>
      </section>
    </article>
  </main>
</BaseLayout>
