---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Hero: featured or latest
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const heroPosts = sortedPosts.filter(p => p.id !== featuredPost.id).slice(0, 2);

// カテゴリ別
const categories = [
  { tag: 'Restaurant', label: 'Restaurant', emoji: '🍣' },
  { tag: 'TravelSpots', label: 'Travel Spots', emoji: '🗼' },
  { tag: 'Transportation', label: 'Transportation', emoji: '🚅' },
  { tag: 'Souvenirs', label: 'Souvenirs', emoji: '👘' },
  { tag: 'Events', label: 'Events', emoji: '🎍' },
  { tag: 'Tips', label: 'Tips', emoji: '💡' },
];

const categoryPosts = categories.map(cat => ({
  ...cat,
  posts: sortedPosts.filter(post => post.data.tags?.includes(cat.tag)).slice(0, 6),
})).filter(cat => cat.posts.length > 0);

// 質問数カウンター
const questionCount = allPosts.length * 4;
---

<BaseLayout title="Home">
  <main class="home">
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-inner">
        <a class="hero-main" href={`/blog/${featuredPost.id}/`}>
          <div class="hero-main-image">
            {featuredPost.data.image && <img src={featuredPost.data.image} alt={featuredPost.data.title} />}
          </div>
          <div class="hero-main-overlay">
            {featuredPost.data.tags?.[0] && <span class="hero-tag">{featuredPost.data.tags[0]}</span>}
            <h1 class="hero-title">{featuredPost.data.title}</h1>
            {featuredPost.data.description && <p class="hero-excerpt">{featuredPost.data.description}</p>}
          </div>
        </a>
        <div class="hero-side">
          {heroPosts.map((post) => (
            <a class="hero-side-card" href={`/blog/${post.id}/`}>
              <div class="hero-side-image">
                {post.data.image && <img src={post.data.image} alt={post.data.title} />}
              </div>
              <div class="hero-side-overlay">
                <h3 class="hero-side-title">{post.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <section class="stats-bar">
      <div class="stats-inner">
        <div class="stat-item">
          <span class="stat-number">{questionCount.toLocaleString()}+</span>
          <span class="stat-label">Questions Answered</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">{allPosts.length}</span>
          <span class="stat-label">Articles</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">Local</span>
          <span class="stat-label">Perspective</span>
        </div>
      </div>
    </section>

    <!-- Category Sections -->
    {categoryPosts.map((cat) => (
      <section class="cat-section">
        <div class="cat-inner">
          <div class="cat-header">
            <h2 class="cat-title">
              <span class="cat-emoji">{cat.emoji}</span>
              {cat.label}
            </h2>
            <a class="cat-more" href={`/tag/${cat.tag}`}>
              View all
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          <div class="cat-grid">
            {cat.posts.map((post, idx) => (
              <a class={`cat-card ${idx === 0 ? 'cat-card-large' : ''}`} href={`/blog/${post.id}/`}>
                <div class="cat-card-image">
                  {post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}
                </div>
                <div class="cat-card-content">
                  <h3 class="cat-card-title">{post.data.title}</h3>
                  {idx === 0 && post.data.description && (
                    <p class="cat-card-excerpt">{post.data.description}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- About / CTA -->
    <section class="home-cta">
      <div class="cta-inner">
        <img src="/images/profile_circle.png" alt="Joe Tanaka" class="cta-avatar" />
        <div class="cta-text">
          <h2>Hi, I'm Joe Tanaka</h2>
          <p>Born in Kamakura, lived across Japan, traveled 20+ countries. I answer real questions from real travelers — no fluff, just practical local knowledge.</p>
          <a href="/aboutme" class="cta-button">Learn more about me</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 0 var(--gap);
  }

  .hero-inner {
    max-width: var(--container-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 8px;
    min-height: 520px;
  }

  .hero-main {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hero-main-image {
    position: absolute;
    inset: 0;
  }

  .hero-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-main-overlay {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding: 40px;
    background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 40%, transparent 70%);
    color: white;
  }

  .hero-main:hover {
    opacity: 1;
  }

  .hero-main:hover .hero-main-image img {
    transform: scale(1.02);
    transition: transform 0.6s ease;
  }

  .hero-tag {
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 12px;
    background: rgba(255,255,255,0.15);
    padding: 4px 12px;
    border-radius: 100px;
    width: fit-content;
    backdrop-filter: blur(4px);
  }

  .hero-title {
    font-size: 3.2rem;
    line-height: 1.15;
    color: white;
    max-width: 600px;
  }

  .hero-excerpt {
    font-size: 1.6rem;
    margin-top: 12px;
    color: rgba(255,255,255,0.8);
    max-width: 500px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-side-card {
    position: relative;
    flex: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: block;
  }

  .hero-side-card:hover {
    opacity: 1;
  }

  .hero-side-card:hover .hero-side-image img {
    transform: scale(1.05);
    transition: transform 0.6s ease;
  }

  .hero-side-image {
    position: absolute;
    inset: 0;
  }

  .hero-side-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .hero-side-overlay {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 20px;
    background: linear-gradient(0deg, rgba(0,0,0,0.75) 0%, transparent 60%);
  }

  .hero-side-title {
    font-size: 1.6rem;
    color: white;
    line-height: 1.3;
    margin: 0;
  }

  @media (max-width: 991px) {
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .hero-main {
      min-height: 360px;
    }
    .hero-side {
      flex-direction: row;
    }
    .hero-side-card {
      min-height: 200px;
    }
    .hero-title {
      font-size: 2.6rem;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 0 12px;
    }
    .hero-inner {
      gap: 6px;
    }
    .hero-main {
      min-height: 280px;
    }
    .hero-main-overlay {
      padding: 24px;
    }
    .hero-title {
      font-size: 2.2rem;
    }
    .hero-side-card {
      min-height: 160px;
    }
    .hero-side-title {
      font-size: 1.3rem;
    }
    .hero-side-overlay {
      padding: 14px;
    }
  }

  /* Stats Bar */
  .stats-bar {
    padding: 0 var(--gap);
    margin-top: 32px;
    margin-bottom: 32px;
  }

  .stats-inner {
    max-width: var(--container-width);
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 48px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-number {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 1.2rem;
    color: var(--color-secondary-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    margin-top: 2px;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background: var(--color-border);
  }

  @media (max-width: 600px) {
    .stats-inner {
      gap: 24px;
    }
    .stat-number {
      font-size: 2rem;
    }
    .stat-label {
      font-size: 1rem;
    }
  }

  /* Category Sections */
  .cat-section {
    padding: 0 var(--gap);
    margin-bottom: 56px;
  }

  .cat-inner {
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .cat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .cat-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .cat-emoji {
    font-size: 2.2rem;
    line-height: 1;
  }

  .cat-more {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-accent);
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .cat-more:hover {
    opacity: 1;
    color: var(--color-accent-hover);
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 8px;
  }

  .cat-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    display: block;
    aspect-ratio: 4 / 3;
  }

  .cat-card:hover {
    opacity: 1;
  }

  .cat-card:hover img {
    transform: scale(1.05);
  }

  .cat-card-large {
    grid-row: 1 / 3;
    aspect-ratio: auto;
  }

  .cat-card-image {
    position: absolute;
    inset: 0;
    background: var(--color-lighter-gray);
  }

  .cat-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .cat-card-content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
    background: linear-gradient(0deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.2) 40%, transparent 65%);
  }

  .cat-card-large .cat-card-content {
    padding: 24px;
  }

  .cat-card-title {
    font-size: 1.4rem;
    color: white;
    line-height: 1.3;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cat-card-large .cat-card-title {
    font-size: 2rem;
    -webkit-line-clamp: 4;
  }

  .cat-card-excerpt {
    font-size: 1.3rem;
    color: rgba(255,255,255,0.75);
    margin-top: 8px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 991px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .cat-card-large {
      grid-column: 1 / 3;
      grid-row: auto;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 600px) {
    .cat-section {
      padding: 0 12px;
      margin-bottom: 40px;
    }
    .cat-grid {
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }
    .cat-card {
      aspect-ratio: 1;
    }
    .cat-card-large {
      grid-column: 1 / 3;
      aspect-ratio: 16 / 9;
    }
    .cat-card-title {
      font-size: 1.2rem;
    }
    .cat-card-large .cat-card-title {
      font-size: 1.6rem;
    }
    .cat-card-content {
      padding: 10px;
    }
    .cat-card-large .cat-card-content {
      padding: 16px;
    }
    .cat-card-excerpt {
      display: none;
    }
  }

  /* CTA */
  .home-cta {
    padding: 0 var(--gap);
    margin-top: 24px;
    margin-bottom: 40px;
  }

  .cta-inner {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 32px;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: var(--shadow-sm);
  }

  .cta-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .cta-text h2 {
    font-size: 2rem;
    margin-bottom: 8px;
  }

  .cta-text p {
    font-size: 1.5rem;
    color: var(--color-secondary-text);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
    border-radius: 100px;
    padding: 8px 20px;
    transition: all 0.2s;
  }

  .cta-button:hover {
    background: var(--color-accent);
    color: white;
    opacity: 1;
  }

  @media (max-width: 600px) {
    .cta-inner {
      flex-direction: column;
      text-align: center;
      padding: 32px 24px;
      gap: 20px;
    }
    .cta-avatar {
      width: 80px;
      height: 80px;
    }
    .cta-text h2 {
      font-size: 1.8rem;
    }
  }
</style>
