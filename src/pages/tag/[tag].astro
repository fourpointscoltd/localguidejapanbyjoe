---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  const tags = new Set<string>();
  allPosts.forEach((post) => {
    post.data.tags?.forEach((tag: string) => tags.add(tag));
  });

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts
        .filter((post) => post.data.tags?.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={tag} description={`Articles tagged with ${tag}`}>
  <main class="gh-main gh-outer">
    <div class="gh-inner">
      <section class="gh-pagehead">
        <h1 class="gh-pagehead-title">{tag}</h1>
        <p class="gh-pagehead-description">{posts.length} articles</p>
      </section>

      <div class="posts-grid">
        {posts.map((post, index) => (
          <PostCard
            title={post.data.title}
            slug={post.id}
            excerpt={post.data.description}
            image={post.data.image}
            author={post.data.author}
            date={post.data.pubDate}
            large={index === 0}
          />
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .posts-grid > :first-child {
    grid-column: 1 / -1;
  }

  @media (max-width: 991px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .posts-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }
</style>
