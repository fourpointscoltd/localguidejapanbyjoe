---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JapanMap from '../../components/JapanMap.astro';
import { prefectures, regions, getPrefecturesByRegion } from '../../data/prefectures';
---

<BaseLayout title="47 Prefectures Guide" description="A local's honest guide to all 47 prefectures of Japan. Ratings, tips, and real opinions from someone who's visited them all.">
  <main class="pref-page">
    <!-- Hero -->
    <section class="pref-hero">
      <div class="pref-hero-inner">
        <div class="pref-hero-text">
          <span class="pref-hero-label">A Local's Honest Guide</span>
          <h1>All 47 Prefectures<br/>of Japan, Rated</h1>
          <p>I've visited every prefecture in Japan. Here's my honest take on each one — where to go, what to skip, and what most travel guides won't tell you.</p>
          <div class="pref-hero-stats">
            <div class="pref-stat">
              <span class="pref-stat-num">47</span>
              <span class="pref-stat-label">Prefectures</span>
            </div>
            <div class="pref-stat">
              <span class="pref-stat-num">8</span>
              <span class="pref-stat-label">Regions</span>
            </div>
            <div class="pref-stat">
              <span class="pref-stat-num">30+</span>
              <span class="pref-stat-label">Years Living in Japan</span>
            </div>
          </div>
        </div>
        <div class="pref-hero-avatar">
          <img src="/images/profile_circle.png" alt="Joe Tanaka" />
        </div>
      </div>
    </section>

    <!-- Interactive Map -->
    <section class="map-section">
      <div class="map-inner">
        <h2 class="section-title">Interactive Map</h2>
        <p class="section-subtitle">Hover over each prefecture to see my rating and local tip.</p>
        <JapanMap />
      </div>
    </section>

    <!-- Region Cards -->
    <section class="regions-section">
      <div class="regions-inner">
        <h2 class="section-title">Explore by Region</h2>
        <div class="region-grid">
          {regions.map((region) => {
            const regionPrefs = getPrefecturesByRegion(region.id);
            const topRated = regionPrefs.filter(p => p.rating >= 4).length;
            return (
              <a class="region-card" href={`/prefectures/${region.id}`}>
                <div class="region-card-image">
                  <img src={region.image} alt={region.name} loading="lazy" />
                </div>
                <div class="region-card-overlay">
                  <span class="region-card-ja">{region.nameJa}</span>
                  <h3 class="region-card-name">{region.name}</h3>
                  <p class="region-card-desc">{region.description}</p>
                  <div class="region-card-meta">
                    <span>{regionPrefs.length} prefectures</span>
                    {topRated > 0 && <span>{topRated} must-visit</span>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Quick Picks -->
    <section class="picks-section">
      <div class="picks-inner">
        <h2 class="section-title">My Top Picks</h2>
        <p class="section-subtitle">These are the prefectures I recommend to every visitor. All rated 5/5.</p>
        <div class="picks-grid">
          {prefectures.filter(p => p.rating === 5).map((pref) => (
            <div class="pick-card">
              <div class="pick-card-image">
                <img src={pref.image} alt={pref.name} loading="lazy" />
              </div>
              <div class="pick-card-content">
                <div class="pick-card-header">
                  <span class="pick-card-ja">{pref.nameJa}</span>
                  <h3>{pref.name}</h3>
                  <div class="pick-rating">{'★'.repeat(pref.rating)}</div>
                </div>
                <p class="pick-card-cities">{pref.cities.join(' · ')}</p>
                <p class="pick-card-review">{pref.review}</p>
                <div class="pick-card-tip">
                  <strong>Local Tip:</strong> {pref.localTip}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Full List -->
    <section class="full-list-section">
      <div class="full-list-inner">
        <h2 class="section-title">All 47 Prefectures at a Glance</h2>
        <div class="full-list">
          {prefectures.map((pref) => (
            <div class="list-item" data-rating={pref.rating}>
              <div class="list-item-rating">
                <span class="rating-num">{pref.rating}</span>
                <span class="rating-stars">{'★'.repeat(pref.rating)}{'☆'.repeat(5 - pref.rating)}</span>
              </div>
              <div class="list-item-info">
                <div class="list-item-header">
                  <span class="list-item-ja">{pref.nameJa}</span>
                  <h3>{pref.name}</h3>
                </div>
                <p class="list-item-cities">{pref.cities.join(', ')}</p>
                <p class="list-item-tip">{pref.localTip}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pref-page { background: var(--color-cream); }

  /* Map */
  .map-section { padding: 56px var(--gap) 32px; }
  .map-inner {
    max-width: 800px;
    margin: 0 auto;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 36px;
    box-shadow: var(--shadow-sm);
  }
  .map-section .section-title { margin-bottom: 8px; }
  .map-section .section-subtitle { margin-bottom: 24px; }

  @media (max-width: 600px) {
    .map-inner { padding: 20px 16px; }
  }

  /* Hero */
  .pref-hero {
    background: linear-gradient(135deg, var(--color-primary, #1b2d3a) 0%, #2a4a5e 100%);
    color: white;
    padding: 64px var(--gap) 72px;
  }
  .pref-hero-inner {
    max-width: var(--container-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 48px;
  }
  .pref-hero-text { flex: 1; }
  .pref-hero-label {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent, #d4563a);
    background: rgba(255,255,255,0.1);
    padding: 6px 14px;
    border-radius: 100px;
    margin-bottom: 16px;
  }
  .pref-hero h1 {
    font-size: 4rem;
    line-height: 1.1;
    color: white;
    margin-bottom: 16px;
  }
  .pref-hero p {
    font-size: 1.7rem;
    color: rgba(255,255,255,0.8);
    max-width: 560px;
    line-height: 1.6;
  }
  .pref-hero-stats {
    display: flex;
    gap: 40px;
    margin-top: 32px;
  }
  .pref-stat { display: flex; flex-direction: column; }
  .pref-stat-num { font-size: 2.8rem; font-weight: 700; color: var(--color-accent, #d4563a); }
  .pref-stat-label { font-size: 1.2rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.04em; }
  .pref-hero-avatar img {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 4px solid rgba(255,255,255,0.2);
  }

  @media (max-width: 767px) {
    .pref-hero { padding: 40px 20px 48px; }
    .pref-hero-inner { flex-direction: column-reverse; text-align: center; gap: 24px; }
    .pref-hero h1 { font-size: 2.8rem; }
    .pref-hero p { font-size: 1.5rem; }
    .pref-hero-stats { justify-content: center; gap: 24px; }
    .pref-hero-avatar img { width: 120px; height: 120px; }
  }

  /* Section Titles */
  .section-title {
    font-size: 2.4rem;
    text-align: center;
    margin-bottom: 12px;
    color: var(--color-primary, #1b2d3a);
  }
  .section-subtitle {
    text-align: center;
    color: var(--color-secondary-text);
    font-size: 1.5rem;
    margin-bottom: 36px;
  }

  /* Region Cards */
  .regions-section { padding: 64px var(--gap); }
  .regions-inner { max-width: var(--container-width); margin: 0 auto; }
  .regions-section .section-title { margin-bottom: 36px; }
  .region-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .region-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    display: block;
  }
  .region-card:hover { opacity: 1; }
  .region-card:hover img { transform: scale(1.05); }
  .region-card-image {
    position: absolute;
    inset: 0;
  }
  .region-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .region-card-overlay {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, transparent 70%);
    color: white;
  }
  .region-card-ja { font-size: 1.2rem; opacity: 0.7; margin-bottom: 2px; }
  .region-card-name { font-size: 1.8rem; margin: 0 0 6px; color: white; }
  .region-card-desc { font-size: 1.2rem; color: rgba(255,255,255,0.75); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .region-card-meta { display: flex; gap: 12px; margin-top: 10px; font-size: 1.1rem; color: rgba(255,255,255,0.6); }

  @media (max-width: 991px) { .region-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .region-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
    .region-card { aspect-ratio: 3 / 4; }
    .region-card-overlay { padding: 16px; }
    .region-card-name { font-size: 1.5rem; }
    .region-card-desc { display: none; }
  }

  /* Top Picks */
  .picks-section { padding: 48px var(--gap) 64px; }
  .picks-inner { max-width: var(--container-width); margin: 0 auto; }
  .picks-grid { display: flex; flex-direction: column; gap: 20px; }
  .pick-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: 320px 1fr;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.3s, transform 0.3s;
  }
  .pick-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .pick-card-image { overflow: hidden; }
  .pick-card-image img { width: 100%; height: 100%; object-fit: cover; min-height: 240px; }
  .pick-card-content { padding: 28px 32px; }
  .pick-card-header { margin-bottom: 8px; }
  .pick-card-ja { font-size: 1.2rem; color: var(--color-secondary-text); }
  .pick-card-header h3 { font-size: 2rem; margin: 0; }
  .pick-rating { color: var(--color-accent); font-size: 1.4rem; letter-spacing: 2px; margin-top: 4px; }
  .pick-card-cities { font-size: 1.3rem; color: var(--color-secondary-text); margin: 4px 0 12px; }
  .pick-card-review { font-size: 1.5rem; line-height: 1.6; color: var(--color-primary-text); margin-bottom: 16px; }
  .pick-card-tip {
    font-size: 1.35rem;
    background: var(--color-accent-light, #fef2ef);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-accent);
    line-height: 1.5;
    color: var(--color-primary-text);
  }

  @media (max-width: 767px) {
    .pick-card { grid-template-columns: 1fr; }
    .pick-card-image img { min-height: 200px; max-height: 200px; }
    .pick-card-content { padding: 20px; }
    .pick-card-header h3 { font-size: 1.8rem; }
  }

  /* Full List */
  .full-list-section { padding: 48px var(--gap) 64px; }
  .full-list-inner { max-width: 900px; margin: 0 auto; }
  .full-list-section .section-title { margin-bottom: 32px; }
  .full-list { display: flex; flex-direction: column; gap: 8px; }
  .list-item {
    display: flex;
    gap: 20px;
    padding: 16px 20px;
    background: var(--color-white);
    border-radius: var(--radius-sm);
    align-items: center;
    transition: box-shadow 0.2s;
  }
  .list-item:hover { box-shadow: var(--shadow-sm); }
  .list-item[data-rating="5"] { border-left: 3px solid var(--color-accent); }
  .list-item[data-rating="4"] { border-left: 3px solid #e8a84c; }
  .list-item-rating { text-align: center; min-width: 60px; flex-shrink: 0; }
  .rating-num { font-size: 2rem; font-weight: 700; color: var(--color-primary); display: block; }
  .rating-stars { font-size: 1.1rem; color: var(--color-accent); letter-spacing: 1px; }
  .list-item-header { display: flex; align-items: baseline; gap: 8px; }
  .list-item-ja { font-size: 1.2rem; color: var(--color-secondary-text); }
  .list-item-header h3 { font-size: 1.6rem; margin: 0; }
  .list-item-cities { font-size: 1.2rem; color: var(--color-secondary-text); margin: 2px 0; }
  .list-item-tip { font-size: 1.3rem; color: var(--color-primary-text); margin: 0; line-height: 1.4; }

  @media (max-width: 600px) {
    .list-item { padding: 12px 14px; gap: 14px; }
    .list-item-header h3 { font-size: 1.4rem; }
    .list-item-tip { font-size: 1.2rem; }
  }
</style>
