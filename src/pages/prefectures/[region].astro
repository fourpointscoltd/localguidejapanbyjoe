---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { regions, prefectures, getPrefecturesByRegion, getRegionById } from '../../data/prefectures';

export function getStaticPaths() {
  return regions.map((region) => ({
    params: { region: region.id },
    props: { region },
  }));
}

const { region } = Astro.props;
const regionPrefs = getPrefecturesByRegion(region.id);
const sortedPrefs = [...regionPrefs].sort((a, b) => b.rating - a.rating);
const topPicks = sortedPrefs.filter(p => p.rating >= 4);
const others = sortedPrefs.filter(p => p.rating < 4);
---

<BaseLayout title={`${region.name} Travel Guide`} description={region.description}>
  <main class="region-page">
    <!-- Hero -->
    <section class="region-hero">
      <div class="region-hero-bg">
        <img src={region.image} alt={region.name} />
      </div>
      <div class="region-hero-overlay">
        <div class="region-hero-inner">
          <a href="/prefectures" class="back-link">&larr; All Prefectures</a>
          <span class="region-hero-ja">{region.nameJa}</span>
          <h1>{region.name}</h1>
          <p>{region.description}</p>
          <div class="region-hero-meta">
            <span>{regionPrefs.length} prefectures</span>
            <span>{topPicks.length} must-visit</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Prefectures -->
    <section class="prefs-section">
      <div class="prefs-inner">
        {topPicks.length > 0 && (
          <>
            <h2 class="prefs-heading">Must-Visit Prefectures</h2>
            <div class="prefs-grid prefs-grid-featured">
              {topPicks.map((pref) => (
                <article class="pref-card pref-card-featured">
                  <div class="pref-card-image">
                    <img src={pref.image} alt={pref.name} loading="lazy" />
                    <div class="pref-card-rating">
                      <span class="pref-rating-stars">{'★'.repeat(pref.rating)}</span>
                      <span class="pref-rating-num">{pref.rating}/5</span>
                    </div>
                  </div>
                  <div class="pref-card-body">
                    <div class="pref-card-header">
                      <span class="pref-card-ja">{pref.nameJa}</span>
                      <h3>{pref.name}</h3>
                    </div>
                    <p class="pref-card-cities">{pref.cities.join(' · ')}</p>
                    <p class="pref-card-review">{pref.review}</p>
                    <div class="pref-card-tip">
                      <strong>Joe's Tip:</strong> {pref.localTip}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}

        {others.length > 0 && (
          <>
            <h2 class="prefs-heading prefs-heading-other">Other Prefectures in {region.name}</h2>
            <div class="prefs-grid prefs-grid-compact">
              {others.map((pref) => (
                <article class="pref-card pref-card-compact">
                  <div class="pref-card-compact-image">
                    <img src={pref.image} alt={pref.name} loading="lazy" />
                  </div>
                  <div class="pref-card-compact-body">
                    <div class="pref-card-compact-header">
                      <span class="pref-card-ja">{pref.nameJa}</span>
                      <h3>{pref.name}</h3>
                      <span class="compact-rating">{'★'.repeat(pref.rating)}{'☆'.repeat(5 - pref.rating)}</span>
                    </div>
                    <p class="pref-card-cities">{pref.cities.join(' · ')}</p>
                    <p class="pref-card-compact-review">{pref.review}</p>
                    <p class="pref-card-compact-tip"><strong>Tip:</strong> {pref.localTip}</p>
                  </div>
                </article>
              ))}
            </div>
          </>
        )}

        <!-- Navigation -->
        <div class="region-nav">
          <a href="/prefectures" class="nav-btn">&larr; Back to All Prefectures</a>
          {(() => {
            const idx = regions.findIndex(r => r.id === region.id);
            const next = regions[(idx + 1) % regions.length];
            return <a href={`/prefectures/${next.id}`} class="nav-btn">Next: {next.name} &rarr;</a>;
          })()}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .region-page { background: var(--color-cream); }

  /* Hero */
  .region-hero { position: relative; min-height: 400px; display: flex; align-items: flex-end; }
  .region-hero-bg { position: absolute; inset: 0; }
  .region-hero-bg img { width: 100%; height: 100%; object-fit: cover; }
  .region-hero-overlay {
    position: relative;
    z-index: 1;
    width: 100%;
    background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, transparent 80%);
    padding: 80px var(--gap) 48px;
  }
  .region-hero-inner { max-width: var(--container-width); margin: 0 auto; color: white; }
  .back-link { color: rgba(255,255,255,0.7); font-size: 1.3rem; display: inline-block; margin-bottom: 16px; }
  .back-link:hover { color: white; opacity: 1; }
  .region-hero-ja { font-size: 1.8rem; opacity: 0.6; }
  .region-hero h1 { font-size: 4rem; color: white; margin: 4px 0 12px; }
  .region-hero p { font-size: 1.7rem; color: rgba(255,255,255,0.8); max-width: 600px; }
  .region-hero-meta { display: flex; gap: 20px; margin-top: 16px; font-size: 1.3rem; color: rgba(255,255,255,0.6); }

  @media (max-width: 767px) {
    .region-hero { min-height: 300px; }
    .region-hero h1 { font-size: 2.8rem; }
    .region-hero p { font-size: 1.4rem; }
  }

  /* Prefectures */
  .prefs-section { padding: 48px var(--gap) 64px; }
  .prefs-inner { max-width: var(--container-width); margin: 0 auto; }
  .prefs-heading {
    font-size: 2rem;
    color: var(--color-primary);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .prefs-heading::after { content: ""; flex: 1; height: 1px; background: var(--color-border); }
  .prefs-heading-other { margin-top: 56px; }

  /* Featured Prefecture Cards */
  .prefs-grid-featured { display: flex; flex-direction: column; gap: 24px; }
  .pref-card-featured {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: 400px 1fr;
    box-shadow: var(--shadow-sm);
  }
  .pref-card-image { position: relative; overflow: hidden; }
  .pref-card-image img { width: 100%; height: 100%; object-fit: cover; min-height: 280px; }
  .pref-card-rating {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
    color: var(--color-accent);
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pref-rating-num { color: white; font-weight: 600; }
  .pref-card-body { padding: 28px 32px; }
  .pref-card-ja { font-size: 1.3rem; color: var(--color-secondary-text); }
  .pref-card-header h3 { font-size: 2.2rem; margin: 2px 0 0; }
  .pref-card-cities { font-size: 1.3rem; color: var(--color-secondary-text); margin: 4px 0 16px; }
  .pref-card-review { font-size: 1.5rem; line-height: 1.65; color: var(--color-primary-text); margin-bottom: 16px; }
  .pref-card-tip {
    font-size: 1.35rem;
    background: var(--color-accent-light, #fef2ef);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-accent);
    line-height: 1.5;
  }

  @media (max-width: 991px) {
    .pref-card-featured { grid-template-columns: 1fr; }
    .pref-card-image img { min-height: 220px; max-height: 260px; }
  }
  @media (max-width: 600px) {
    .pref-card-body { padding: 20px; }
    .pref-card-header h3 { font-size: 1.8rem; }
    .pref-card-review { font-size: 1.4rem; }
  }

  /* Compact Cards */
  .prefs-grid-compact {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .pref-card-compact {
    background: var(--color-white);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .pref-card-compact-image { height: 160px; overflow: hidden; }
  .pref-card-compact-image img { width: 100%; height: 100%; object-fit: cover; }
  .pref-card-compact-body { padding: 16px 20px; }
  .pref-card-compact-header { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .pref-card-compact-header h3 { font-size: 1.6rem; margin: 0; }
  .compact-rating { font-size: 1.2rem; color: var(--color-accent); letter-spacing: 1px; }
  .pref-card-compact-review { font-size: 1.35rem; line-height: 1.5; color: var(--color-primary-text); margin: 8px 0; }
  .pref-card-compact-tip { font-size: 1.25rem; color: var(--color-secondary-text); margin: 0; font-style: italic; }

  @media (max-width: 767px) {
    .prefs-grid-compact { grid-template-columns: 1fr; }
  }

  /* Navigation */
  .region-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .nav-btn {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 10px 20px;
    border: 2px solid var(--color-accent);
    border-radius: 100px;
    transition: all 0.2s;
  }
  .nav-btn:hover { background: var(--color-accent); color: white; opacity: 1; }
</style>
