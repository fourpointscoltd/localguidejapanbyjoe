---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;

// サイト設定
const site = {
  title: 'Local Guide Japan',
  description: 'Welcome to Local Guide Japan, your go-to resource for authentic travel experiences in Japan. Discover hidden gems, practical tips, and cultural insights curated by a local with a passion for exploring',
  metaTitle: 'Local Guide Japan | Essential Japan Travel Tips & Hidden Gems',
  metaDescription: 'Planning a trip to Japan? Local Guide Japan provides essential travel tips, hidden gems, and practical advice from a Japanese local. Avoid tourist traps and explore Japan like a pro, by Joe Tanaka!',
  logo: '',
  url: Astro.url.origin,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title} | {site.title}</title>
  <meta name="description" content={description || site.description}>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>

<body class="is-head-left-logo">
  <div class="gh-site">
    <Header siteTitle={site.title} siteLogo={site.logo} />

    <slot />

    <Footer siteTitle={site.title} />
  </div>
</body>
</html>
