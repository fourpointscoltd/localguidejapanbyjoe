---
import { prefectures, regions } from '../data/prefectures';
import { prefecturePaths, prefectureCentroids } from '../data/japan-map-paths';

const ratingColors: Record<number, string> = {
  5: '#d4563a',
  4: '#e8a84c',
  3: '#5ba3d9',
  2: '#94a3b8',
  1: '#cbd5e1',
};

const prefMap = new Map(prefectures.map(p => [p.id, p]));
---

<div class="japan-map-container">
  <!-- Region Tabs -->
  <div class="map-tabs">
    <button class="map-tab active" data-region="all" data-vb="-170 0 810 720">All Japan</button>
    <button class="map-tab" data-region="hokkaido" data-vb="320 -18 325 195">Hokkaido</button>
    <button class="map-tab" data-region="tohoku" data-vb="280 114 180 210">Tohoku</button>
    <button class="map-tab" data-region="kanto" data-vb="255 255 180 160">Kanto</button>
    <button class="map-tab" data-region="chubu" data-vb="190 220 200 190">Chubu</button>
    <button class="map-tab" data-region="kansai" data-vb="155 300 145 130">Kansai</button>
    <button class="map-tab" data-region="chugoku" data-vb="55 285 170 130">Chugoku</button>
    <button class="map-tab" data-region="shikoku" data-vb="95 340 140 110">Shikoku</button>
    <button class="map-tab" data-region="kyushu-okinawa" data-vb="-172 335 340 400">Kyushu</button>
  </div>

  <!-- Legend -->
  <div class="map-legend">
    <div class="legend-items">
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[5]}`}></span>
        <span class="legend-label">Must-Visit</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[4]}`}></span>
        <span class="legend-label">Recommended</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[3]}`}></span>
        <span class="legend-label">Consider</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[2]}`}></span>
        <span class="legend-label">Repeat Visit</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[1]}`}></span>
        <span class="legend-label">Skip</span>
      </div>
    </div>
  </div>

  <!-- Map -->
  <div class="map-wrapper">
    <svg viewBox="-170 0 810 720" class="japan-svg" id="japan-svg" xmlns="http://www.w3.org/2000/svg">
      {Object.entries(prefecturePaths).map(([id, pathD]) => {
        const pref = prefMap.get(id);
        if (!pref) return null;
        const color = ratingColors[pref.rating];
        return (
          <path
            class="pref-path"
            d={pathD}
            fill={color}
            stroke="white"
            stroke-width="0.8"
            data-id={id}
            data-name={pref.name}
            data-nameja={pref.nameJa}
            data-rating={String(pref.rating)}
            data-cities={pref.cities.join(', ')}
            data-tip={pref.localTip}
            data-region={pref.region}
          />
        );
      })}
      {Object.entries(prefectureCentroids).map(([id, pos]) => {
        const pref = prefMap.get(id);
        if (!pref) return null;
        return (
          <text
            class="pref-label"
            data-region={pref.region}
            x={pos.x}
            y={pos.y + 1}
            text-anchor="middle"
            dominant-baseline="central"
            fill="white"
            font-size="9"
            font-weight="700"
            style="pointer-events:none;text-shadow:0 1px 2px rgba(0,0,0,0.4)"
          >{pref.rating}</text>
        );
      })}
    </svg>

    <!-- Mobile bottom sheet -->
    <div class="mobile-info" id="mobile-info">
      <button class="mobile-info-close" id="mobile-info-close" aria-label="Close">&times;</button>
      <div class="mi-header">
        <span class="mi-ja" id="mi-ja"></span>
        <span class="mi-name" id="mi-name"></span>
      </div>
      <div class="mi-rating" id="mi-rating"></div>
      <p class="mi-cities" id="mi-cities"></p>
      <p class="mi-tip" id="mi-tip"></p>
      <a class="mi-link" id="mi-link" href="/prefectures">View Region Guide</a>
    </div>

    <!-- Desktop tooltip -->
    <div class="map-tooltip" id="map-tooltip">
      <div class="tt-header">
        <span class="tt-ja" id="tt-ja"></span>
        <span class="tt-name" id="tt-name"></span>
      </div>
      <div class="tt-rating" id="tt-rating"></div>
      <p class="tt-cities" id="tt-cities"></p>
      <p class="tt-tip" id="tt-tip"></p>
      <a class="tt-link" id="tt-link" href="/prefectures">View Region Guide</a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var svg = document.getElementById('japan-svg');
    var allPaths = document.querySelectorAll('.pref-path');
    var allTabs = document.querySelectorAll('.map-tab');
    var allLabels = document.querySelectorAll('.pref-label');
    var tooltip = document.getElementById('map-tooltip');
    var mobileInfo = document.getElementById('mobile-info');

    // --- TABS ---
    allTabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var region = this.getAttribute('data-region');
        var vb = this.getAttribute('data-vb');

        // Active state
        allTabs.forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');

        // Zoom
        if (svg && vb) {
          svg.setAttribute('viewBox', vb);
        }

        // Dim others
        allPaths.forEach(function(p) {
          var pr = p.getAttribute('data-region');
          if (region === 'all') {
            p.classList.remove('dimmed');
          } else {
            if (pr === region) {
              p.classList.remove('dimmed');
            } else {
              p.classList.add('dimmed');
            }
          }
        });

        // Labels
        allLabels.forEach(function(l) {
          var lr = l.getAttribute('data-region');
          if (region === 'all') {
            l.style.display = '';
          } else {
            l.style.display = (lr === region) ? '' : 'none';
          }
        });

        // Close mobile info
        if (mobileInfo) mobileInfo.classList.remove('visible');
      });
    });

    // --- PREFECTURE INTERACTION ---
    var isMobile = function() { return window.innerWidth < 768; };

    allPaths.forEach(function(path) {
      // Desktop hover
      path.addEventListener('mouseenter', function(e) {
        if (isMobile()) return;
        this.classList.add('active');
        fillTooltip(this, 'tt');
        if (tooltip) tooltip.classList.add('visible');
      });

      path.addEventListener('mousemove', function(e) {
        if (isMobile() || !tooltip) return;
        var wrapper = document.querySelector('.map-wrapper');
        if (!wrapper) return;
        var rect = wrapper.getBoundingClientRect();
        var x = e.clientX - rect.left + 20;
        var y = e.clientY - rect.top - 10;
        if (x + 300 > rect.width) x = e.clientX - rect.left - 310;
        if (y + 200 > rect.height) y = rect.height - 210;
        if (y < 0) y = 10;
        tooltip.style.left = x + 'px';
        tooltip.style.top = y + 'px';
      });

      path.addEventListener('mouseleave', function() {
        if (isMobile()) return;
        this.classList.remove('active');
        if (tooltip) tooltip.classList.remove('visible');
      });

      // Mobile tap
      path.addEventListener('click', function(e) {
        if (!isMobile()) return;
        fillTooltip(this, 'mi');
        if (mobileInfo) mobileInfo.classList.add('visible');
      });
    });

    // Close mobile info
    var closeBtn = document.getElementById('mobile-info-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        if (mobileInfo) mobileInfo.classList.remove('visible');
      });
    }

    function fillTooltip(el, prefix) {
      var rating = parseInt(el.getAttribute('data-rating') || '0');
      var region = el.getAttribute('data-region') || '';
      var stars = '';
      for (var i = 0; i < rating; i++) stars += '\u2605';
      for (var i = rating; i < 5; i++) stars += '\u2606';

      setText(prefix + '-ja', el.getAttribute('data-nameja') || '');
      setText(prefix + '-name', el.getAttribute('data-name') || '');
      setText(prefix + '-rating', stars + ' (' + rating + '/5)');
      setText(prefix + '-cities', el.getAttribute('data-cities') || '');
      setText(prefix + '-tip', el.getAttribute('data-tip') || '');

      var link = document.getElementById(prefix + '-link');
      if (link) link.setAttribute('href', '/prefectures/' + region);
    }

    function setText(id, val) {
      var el = document.getElementById(id);
      if (el) el.textContent = val;
    }
  });
</script>

<style>
  .japan-map-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Tabs */
  .map-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .map-tabs::-webkit-scrollbar { display: none; }

  .map-tab {
    flex-shrink: 0;
    padding: 8px 16px;
    border: 1.5px solid var(--color-border, #e8e5e0);
    border-radius: 100px;
    background: var(--color-white, white);
    color: var(--color-primary-text, #333);
    font-size: 1.25rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .map-tab:hover {
    border-color: var(--color-accent, #d4563a);
    color: var(--color-accent, #d4563a);
  }

  .map-tab.active {
    background: var(--color-accent, #d4563a);
    border-color: var(--color-accent, #d4563a);
    color: white;
  }

  /* Legend */
  .legend-items {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .legend-label {
    font-size: 1.15rem;
    color: var(--color-secondary-text, #6b7280);
  }

  /* Map */
  .map-wrapper {
    position: relative;
    width: 100%;
  }

  .japan-svg {
    width: 100%;
    height: auto;
    max-height: 520px;
  }

  .pref-path {
    cursor: pointer;
    transition: opacity 0.2s, filter 0.2s;
    stroke-linejoin: round;
  }

  .pref-path:hover,
  .pref-path.active {
    opacity: 0.85;
    filter: brightness(1.1) drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    stroke-width: 1.5;
  }

  .pref-path.dimmed {
    opacity: 0.12;
    filter: saturate(0.2);
  }

  .pref-label {
    pointer-events: none;
    user-select: none;
  }

  /* Desktop Tooltip */
  .map-tooltip {
    position: absolute;
    background: white;
    border: 1px solid var(--color-border, #e8e5e0);
    border-radius: 12px;
    padding: 16px 18px;
    width: 290px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s, transform 0.15s;
    z-index: 100;
  }

  .map-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tt-header { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
  .tt-ja { font-size: 1.4rem; color: var(--color-secondary-text, #6b7280); }
  .tt-name { font-size: 1.8rem; font-weight: 700; color: var(--color-primary, #1b2d3a); }
  .tt-rating { font-size: 1.4rem; color: var(--color-accent, #d4563a); letter-spacing: 1px; margin-bottom: 6px; }
  .tt-cities { font-size: 1.2rem; color: var(--color-secondary-text, #6b7280); margin: 0 0 8px; }
  .tt-tip { font-size: 1.3rem; color: var(--color-primary-text, #333); line-height: 1.5; margin: 0; padding-top: 8px; border-top: 1px solid var(--color-border, #e8e5e0); }
  .tt-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent, #d4563a);
    pointer-events: auto;
  }
  .tt-link:hover { opacity: 1; text-decoration: underline; }

  /* Mobile Bottom Sheet */
  .mobile-info {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-radius: 16px 16px 0 0;
    padding: 20px 20px 28px;
    box-shadow: 0 -4px 24px rgba(0,0,0,0.15);
    z-index: 200;
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }

  .mobile-info.visible {
    transform: translateY(0);
  }

  .mobile-info-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 2.4rem;
    color: var(--color-secondary-text);
    cursor: pointer;
    line-height: 1;
    padding: 4px;
  }

  .mi-header { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
  .mi-ja { font-size: 1.4rem; color: var(--color-secondary-text); }
  .mi-name { font-size: 1.8rem; font-weight: 700; color: var(--color-primary); }
  .mi-rating { font-size: 1.4rem; color: var(--color-accent); letter-spacing: 1px; margin-bottom: 6px; }
  .mi-cities { font-size: 1.2rem; color: var(--color-secondary-text); margin: 0 0 8px; }
  .mi-tip { font-size: 1.3rem; line-height: 1.5; margin: 0 0 12px; border-top: 1px solid var(--color-border); padding-top: 8px; }
  .mi-link {
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 8px 20px;
    border: 2px solid var(--color-accent);
    border-radius: 100px;
  }
  .mi-link:hover { background: var(--color-accent); color: white; opacity: 1; }

  @media (max-width: 767px) {
    .map-tab { padding: 7px 14px; font-size: 1.2rem; }
    .map-tooltip { display: none !important; }
    .mobile-info { display: block; }
    .japan-svg { max-height: 400px; }
  }

  @media (min-width: 768px) {
    .mobile-info { display: none !important; }
  }
</style>
