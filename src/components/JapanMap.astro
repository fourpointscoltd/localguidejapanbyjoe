---
import { prefectures } from '../data/prefectures';
import { prefecturePaths, prefectureCentroids } from '../data/japan-map-paths';

const ratingColors: Record<number, string> = {
  5: '#d4563a',
  4: '#e8a84c',
  3: '#5ba3d9',
  2: '#94a3b8',
  1: '#cbd5e1',
};

const ratingBorders: Record<number, string> = {
  5: '#b8432a',
  4: '#d49540',
  3: '#4a8fc0',
  2: '#7f8ea0',
  1: '#adb5bd',
};

// Build lookup
const prefMap = new Map(prefectures.map(p => [p.id, p]));
---

<div class="japan-map-container">
  <div class="map-legend">
    <h3>Joe's Rating</h3>
    <div class="legend-items">
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[5]}`}></span>
        <span class="legend-label">Must-Visit</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[4]}`}></span>
        <span class="legend-label">Highly Recommended</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[3]}`}></span>
        <span class="legend-label">Worth Considering</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[2]}`}></span>
        <span class="legend-label">For Repeat Visitors</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[1]}`}></span>
        <span class="legend-label">Skip for Now</span>
      </div>
    </div>
    <p class="legend-hint">Hover or tap a prefecture</p>
  </div>

  <div class="map-wrapper">
    <svg viewBox="-170 0 810 720" class="japan-svg" xmlns="http://www.w3.org/2000/svg">

      {/* Render prefecture shapes */}
      {Object.entries(prefecturePaths).map(([id, pathD]) => {
        const pref = prefMap.get(id);
        if (!pref) return null;
        const color = ratingColors[pref.rating];
        const border = ratingBorders[pref.rating];
        return (
          <path
            class="pref-path"
            id={`pref-${id}`}
            d={pathD}
            fill={color}
            stroke="white"
            stroke-width="0.8"
            data-id={id}
            data-name={pref.name}
            data-nameja={pref.nameJa}
            data-rating={pref.rating}
            data-cities={pref.cities.join(', ')}
            data-tip={pref.localTip}
            data-region={pref.region}
          />
        );
      })}

      {/* Rating labels on larger prefectures */}
      {Object.entries(prefectureCentroids).map(([id, pos]) => {
        const pref = prefMap.get(id);
        if (!pref) return null;
        return (
          <text
            class="pref-label"
            x={pos.x}
            y={pos.y + 1}
            text-anchor="middle"
            dominant-baseline="central"
            fill="white"
            font-size="9"
            font-weight="700"
            style="pointer-events:none;text-shadow:0 1px 2px rgba(0,0,0,0.4)"
          >{pref.rating}</text>
        );
      })}
    </svg>

    <div class="map-tooltip" id="map-tooltip">
      <div class="tooltip-header">
        <span class="tooltip-ja" id="tooltip-ja"></span>
        <span class="tooltip-name" id="tooltip-name"></span>
      </div>
      <div class="tooltip-rating" id="tooltip-rating"></div>
      <p class="tooltip-cities" id="tooltip-cities"></p>
      <p class="tooltip-tip" id="tooltip-tip"></p>
      <a class="tooltip-link" id="tooltip-link" href="#">View Region Guide →</a>
    </div>
  </div>
</div>

<script>
  const paths = document.querySelectorAll('.pref-path');
  const tooltip = document.getElementById('map-tooltip');
  const tooltipJa = document.getElementById('tooltip-ja');
  const tooltipName = document.getElementById('tooltip-name');
  const tooltipRating = document.getElementById('tooltip-rating');
  const tooltipCities = document.getElementById('tooltip-cities');
  const tooltipTip = document.getElementById('tooltip-tip');
  const tooltipLink = document.getElementById('tooltip-link') as HTMLAnchorElement;

  paths.forEach(path => {
    path.addEventListener('mouseenter', (e) => {
      const el = e.currentTarget as Element;
      el.classList.add('active');
      const rating = parseInt(el.getAttribute('data-rating') || '0');
      const region = el.getAttribute('data-region') || '';

      if (tooltipJa) tooltipJa.textContent = el.getAttribute('data-nameja') || '';
      if (tooltipName) tooltipName.textContent = el.getAttribute('data-name') || '';
      if (tooltipRating) tooltipRating.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating) + ` (${rating}/5)`;
      if (tooltipCities) tooltipCities.textContent = el.getAttribute('data-cities') || '';
      if (tooltipTip) tooltipTip.textContent = el.getAttribute('data-tip') || '';
      if (tooltipLink) tooltipLink.href = `/prefectures/${region}`;
      if (tooltip) tooltip.classList.add('visible');
    });

    path.addEventListener('mousemove', (e) => {
      if (!tooltip) return;
      const mapWrapper = document.querySelector('.map-wrapper');
      if (!mapWrapper) return;
      const rect = mapWrapper.getBoundingClientRect();
      const me = e as MouseEvent;
      let x = me.clientX - rect.left + 20;
      let y = me.clientY - rect.top - 10;
      if (x + 300 > rect.width) x = me.clientX - rect.left - 310;
      if (y + 200 > rect.height) y = rect.height - 210;
      if (y < 0) y = 10;
      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
    });

    path.addEventListener('mouseleave', (e) => {
      (e.currentTarget as Element).classList.remove('active');
      if (tooltip) tooltip.classList.remove('visible');
    });

    // Mobile tap
    path.addEventListener('click', (e) => {
      const el = e.currentTarget as Element;
      const region = el.getAttribute('data-region') || '';
      // On mobile, navigate to region
      if (window.innerWidth < 768) {
        window.location.href = `/prefectures/${region}`;
      }
    });
  });
</script>

<style>
  .japan-map-container {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .map-legend {
    flex-shrink: 0;
    width: 130px;
    padding-top: 16px;
  }

  .map-legend h3 {
    font-size: 1.4rem;
    margin-bottom: 12px;
    color: var(--color-primary, #1b2d3a);
  }

  .legend-items {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend-dot {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .legend-label {
    font-size: 1.2rem;
    color: var(--color-primary-text);
    letter-spacing: 1px;
  }

  .legend-hint {
    font-size: 1.1rem;
    color: var(--color-secondary-text);
    margin-top: 16px;
    font-style: italic;
  }

  .map-wrapper {
    position: relative;
    flex: 1;
    max-width: 560px;
  }

  .japan-svg {
    width: 100%;
    height: auto;
  }

  .pref-path {
    cursor: pointer;
    transition: opacity 0.15s, filter 0.15s, transform 0.15s;
    stroke-linejoin: round;
  }

  .pref-path:hover,
  .pref-path.active {
    opacity: 0.85;
    filter: brightness(1.1) drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    stroke-width: 1.5;
    stroke: white;
  }

  .pref-label {
    pointer-events: none;
    user-select: none;
  }

  /* Tooltip */
  .map-tooltip {
    position: absolute;
    background: white;
    border: 1px solid var(--color-border, #e8e5e0);
    border-radius: 12px;
    padding: 16px 18px;
    width: 290px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s, transform 0.15s;
    z-index: 100;
  }

  .map-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tooltip-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }

  .tooltip-ja {
    font-size: 1.4rem;
    color: var(--color-secondary-text, #6b7280);
  }

  .tooltip-name {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-primary, #1b2d3a);
  }

  .tooltip-rating {
    font-size: 1.4rem;
    color: var(--color-accent, #d4563a);
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .tooltip-cities {
    font-size: 1.2rem;
    color: var(--color-secondary-text, #6b7280);
    margin: 0 0 8px;
  }

  .tooltip-tip {
    font-size: 1.3rem;
    color: var(--color-primary-text, #333);
    line-height: 1.5;
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--color-border, #e8e5e0);
  }

  .tooltip-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent, #d4563a);
    pointer-events: auto;
  }

  .tooltip-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .japan-map-container {
      flex-direction: column;
    }

    .map-legend {
      width: 100%;
      padding-top: 0;
    }

    .legend-items {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px;
    }

    .legend-hint { display: none; }

    .map-wrapper {
      max-width: 100%;
    }

    .map-tooltip {
      display: none !important;
    }
  }
</style>
