---
import { prefectures, regions } from '../data/prefectures';
import { prefecturePaths, prefectureCentroids } from '../data/japan-map-paths';

const ratingColors: Record<number, string> = {
  5: '#d4563a',
  4: '#e8a84c',
  3: '#5ba3d9',
  2: '#94a3b8',
  1: '#cbd5e1',
};

const regionViewBoxes: Record<string, string> = {
  'all': '-170 0 810 720',
  'hokkaido': '320 -18 325 195',
  'tohoku': '280 114 180 210',
  'kanto': '255 255 180 160',
  'chubu': '190 220 200 190',
  'kansai': '155 300 145 130',
  'chugoku': '55 285 170 130',
  'shikoku': '95 340 140 110',
  'kyushu-okinawa': '-172 335 340 400',
};

const prefMap = new Map(prefectures.map(p => [p.id, p]));
---

<div class="japan-map-container">
  <!-- Region Tabs -->
  <div class="map-tabs" id="map-tabs">
    <button class="map-tab active" data-region="all">All Japan</button>
    {regions.map((r) => (
      <button class="map-tab" data-region={r.id}>{r.name}</button>
    ))}
  </div>

  <!-- Legend -->
  <div class="map-legend">
    <div class="legend-items">
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[5]}`}></span>
        <span class="legend-label">Must-Visit</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[4]}`}></span>
        <span class="legend-label">Recommended</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[3]}`}></span>
        <span class="legend-label">Consider</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[2]}`}></span>
        <span class="legend-label">Repeat Visit</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style={`background: ${ratingColors[1]}`}></span>
        <span class="legend-label">Skip</span>
      </div>
    </div>
  </div>

  <!-- Map -->
  <div class="map-wrapper">
    <svg viewBox="-170 0 810 720" class="japan-svg" id="japan-svg" xmlns="http://www.w3.org/2000/svg">
      {Object.entries(prefecturePaths).map(([id, pathD]) => {
        const pref = prefMap.get(id);
        if (!pref) return null;
        const color = ratingColors[pref.rating];
        return (
          <path
            class="pref-path"
            id={`pref-${id}`}
            d={pathD}
            fill={color}
            stroke="white"
            stroke-width="0.8"
            data-id={id}
            data-name={pref.name}
            data-nameja={pref.nameJa}
            data-rating={pref.rating}
            data-cities={pref.cities.join(', ')}
            data-tip={pref.localTip}
            data-region={pref.region}
          />
        );
      })}
      {Object.entries(prefectureCentroids).map(([id, pos]) => {
        const pref = prefMap.get(id);
        if (!pref) return null;
        return (
          <text
            class="pref-label"
            data-region={pref.region}
            x={pos.x}
            y={pos.y + 1}
            text-anchor="middle"
            dominant-baseline="central"
            fill="white"
            font-size="9"
            font-weight="700"
            style="pointer-events:none;text-shadow:0 1px 2px rgba(0,0,0,0.4)"
          >{pref.rating}</text>
        );
      })}
    </svg>

    <!-- Mobile info card (shows on tap) -->
    <div class="mobile-info" id="mobile-info">
      <button class="mobile-info-close" id="mobile-info-close">&times;</button>
      <div class="mobile-info-header">
        <span class="mobile-info-ja" id="mobile-info-ja"></span>
        <span class="mobile-info-name" id="mobile-info-name"></span>
      </div>
      <div class="mobile-info-rating" id="mobile-info-rating"></div>
      <p class="mobile-info-cities" id="mobile-info-cities"></p>
      <p class="mobile-info-tip" id="mobile-info-tip"></p>
      <a class="mobile-info-link" id="mobile-info-link" href="#">View Region Guide →</a>
    </div>

    <!-- Desktop tooltip -->
    <div class="map-tooltip" id="map-tooltip">
      <div class="tooltip-header">
        <span class="tooltip-ja" id="tooltip-ja"></span>
        <span class="tooltip-name" id="tooltip-name"></span>
      </div>
      <div class="tooltip-rating" id="tooltip-rating"></div>
      <p class="tooltip-cities" id="tooltip-cities"></p>
      <p class="tooltip-tip" id="tooltip-tip"></p>
      <a class="tooltip-link" id="tooltip-link" href="#">View Region Guide →</a>
    </div>
  </div>
</div>

<script define:vars={{ regionViewBoxes }}>
  const svg = document.getElementById('japan-svg');
  const paths = document.querySelectorAll('.pref-path');
  const tabs = document.querySelectorAll('.map-tab');
  const tooltip = document.getElementById('map-tooltip');
  const mobileInfo = document.getElementById('mobile-info');
  let currentRegion = 'all';

  // Tab switching with animated zoom
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const region = tab.getAttribute('data-region') || 'all';
      currentRegion = region;

      // Update active tab
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');

      // Animate viewBox
      if (svg) {
        svg.style.transition = 'none';
        svg.setAttribute('viewBox', regionViewBoxes[region] || regionViewBoxes['all']);
      }

      // Dim non-region prefectures
      paths.forEach(p => {
        const prefRegion = p.getAttribute('data-region');
        if (region === 'all') {
          p.classList.remove('dimmed');
        } else {
          p.classList.toggle('dimmed', prefRegion !== region);
        }
      });

      // Update labels visibility
      document.querySelectorAll('.pref-label').forEach(l => {
        const lr = l.getAttribute('data-region');
        if (region === 'all') {
          (l as HTMLElement).style.display = '';
        } else {
          (l as HTMLElement).style.display = lr === region ? '' : 'none';
        }
      });

      // Close mobile info
      if (mobileInfo) mobileInfo.classList.remove('visible');
    });
  });

  // Desktop hover
  const isMobile = () => window.innerWidth < 768;

  paths.forEach(path => {
    path.addEventListener('mouseenter', (e) => {
      if (isMobile()) return;
      const el = e.currentTarget as Element;
      el.classList.add('active');
      showTooltipData(el);
      if (tooltip) tooltip.classList.add('visible');
    });

    path.addEventListener('mousemove', (e) => {
      if (isMobile() || !tooltip) return;
      const mapWrapper = document.querySelector('.map-wrapper');
      if (!mapWrapper) return;
      const rect = mapWrapper.getBoundingClientRect();
      const me = e as MouseEvent;
      let x = me.clientX - rect.left + 20;
      let y = me.clientY - rect.top - 10;
      if (x + 300 > rect.width) x = me.clientX - rect.left - 310;
      if (y + 200 > rect.height) y = rect.height - 210;
      if (y < 0) y = 10;
      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
    });

    path.addEventListener('mouseleave', (e) => {
      if (isMobile()) return;
      (e.currentTarget as Element).classList.remove('active');
      if (tooltip) tooltip.classList.remove('visible');
    });

    // Mobile tap -> show info card
    path.addEventListener('click', (e) => {
      if (!isMobile()) return;
      e.preventDefault();
      const el = e.currentTarget as Element;
      showMobileInfo(el);
    });
  });

  function showTooltipData(el: Element) {
    const rating = parseInt(el.getAttribute('data-rating') || '0');
    const region = el.getAttribute('data-region') || '';
    const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);

    const set = (id: string, val: string) => {
      const e = document.getElementById(id);
      if (e) e.textContent = val;
    };
    set('tooltip-ja', el.getAttribute('data-nameja') || '');
    set('tooltip-name', el.getAttribute('data-name') || '');
    set('tooltip-rating', stars + ` (${rating}/5)`);
    set('tooltip-cities', el.getAttribute('data-cities') || '');
    set('tooltip-tip', el.getAttribute('data-tip') || '');
    const link = document.getElementById('tooltip-link') as HTMLAnchorElement;
    if (link) link.href = `/prefectures/${region}`;
  }

  function showMobileInfo(el: Element) {
    const rating = parseInt(el.getAttribute('data-rating') || '0');
    const region = el.getAttribute('data-region') || '';
    const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);

    const set = (id: string, val: string) => {
      const e = document.getElementById(id);
      if (e) e.textContent = val;
    };
    set('mobile-info-ja', el.getAttribute('data-nameja') || '');
    set('mobile-info-name', el.getAttribute('data-name') || '');
    set('mobile-info-rating', stars + ` (${rating}/5)`);
    set('mobile-info-cities', el.getAttribute('data-cities') || '');
    set('mobile-info-tip', el.getAttribute('data-tip') || '');
    const link = document.getElementById('mobile-info-link') as HTMLAnchorElement;
    if (link) link.href = `/prefectures/${region}`;
    if (mobileInfo) mobileInfo.classList.add('visible');
  }

  // Close mobile info
  document.getElementById('mobile-info-close')?.addEventListener('click', () => {
    if (mobileInfo) mobileInfo.classList.remove('visible');
  });
</script>

<style>
  .japan-map-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Tabs */
  .map-tabs {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .map-tabs::-webkit-scrollbar { display: none; }

  .map-tab {
    flex-shrink: 0;
    padding: 8px 16px;
    border: 1.5px solid var(--color-border, #e8e5e0);
    border-radius: 100px;
    background: var(--color-white, white);
    color: var(--color-primary-text, #333);
    font-size: 1.25rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .map-tab:hover {
    border-color: var(--color-accent, #d4563a);
    color: var(--color-accent, #d4563a);
  }

  .map-tab.active {
    background: var(--color-accent, #d4563a);
    border-color: var(--color-accent, #d4563a);
    color: white;
  }

  /* Legend - horizontal */
  .map-legend {
    padding: 0;
  }

  .legend-items {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .legend-label {
    font-size: 1.15rem;
    color: var(--color-secondary-text, #6b7280);
  }

  /* Map */
  .map-wrapper {
    position: relative;
    width: 100%;
  }

  .japan-svg {
    width: 100%;
    height: auto;
    max-height: 520px;
    transition: viewBox 0.4s ease;
  }

  .pref-path {
    cursor: pointer;
    transition: opacity 0.2s, filter 0.2s;
    stroke-linejoin: round;
  }

  .pref-path:hover,
  .pref-path.active {
    opacity: 0.85;
    filter: brightness(1.1) drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    stroke-width: 1.5;
  }

  .pref-path.dimmed {
    opacity: 0.15;
    filter: saturate(0.3);
  }

  .pref-label {
    pointer-events: none;
    user-select: none;
  }

  /* Desktop Tooltip */
  .map-tooltip {
    position: absolute;
    background: white;
    border: 1px solid var(--color-border, #e8e5e0);
    border-radius: 12px;
    padding: 16px 18px;
    width: 290px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s, transform 0.15s;
    z-index: 100;
  }

  .map-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tooltip-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }

  .tooltip-ja {
    font-size: 1.4rem;
    color: var(--color-secondary-text, #6b7280);
  }

  .tooltip-name {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-primary, #1b2d3a);
  }

  .tooltip-rating {
    font-size: 1.4rem;
    color: var(--color-accent, #d4563a);
    letter-spacing: 1px;
    margin-bottom: 6px;
  }

  .tooltip-cities {
    font-size: 1.2rem;
    color: var(--color-secondary-text, #6b7280);
    margin: 0 0 8px;
  }

  .tooltip-tip {
    font-size: 1.3rem;
    color: var(--color-primary-text, #333);
    line-height: 1.5;
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--color-border, #e8e5e0);
  }

  .tooltip-link {
    display: inline-block;
    margin-top: 10px;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent, #d4563a);
    pointer-events: auto;
  }

  .tooltip-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* Mobile Info Card */
  .mobile-info {
    display: none;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-radius: 16px 16px 0 0;
    padding: 20px;
    box-shadow: 0 -4px 24px rgba(0,0,0,0.15);
    z-index: 200;
    transform: translateY(100%);
    transition: transform 0.25s ease;
  }

  .mobile-info.visible {
    transform: translateY(0);
  }

  .mobile-info-close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    font-size: 2.4rem;
    color: var(--color-secondary-text);
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }

  .mobile-info-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 4px;
  }

  .mobile-info-ja { font-size: 1.4rem; color: var(--color-secondary-text); }
  .mobile-info-name { font-size: 1.8rem; font-weight: 700; color: var(--color-primary); }
  .mobile-info-rating { font-size: 1.4rem; color: var(--color-accent); letter-spacing: 1px; margin-bottom: 6px; }
  .mobile-info-cities { font-size: 1.2rem; color: var(--color-secondary-text); margin: 0 0 8px; }
  .mobile-info-tip { font-size: 1.3rem; line-height: 1.5; margin: 0 0 12px; border-top: 1px solid var(--color-border); padding-top: 8px; }
  .mobile-info-link {
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-accent);
    padding: 8px 20px;
    border: 2px solid var(--color-accent);
    border-radius: 100px;
  }

  @media (max-width: 767px) {
    .map-tab {
      padding: 7px 14px;
      font-size: 1.2rem;
    }

    .map-tooltip {
      display: none !important;
    }

    .mobile-info {
      display: block;
    }

    .japan-svg {
      max-height: 400px;
    }
  }

  @media (min-width: 768px) {
    .mobile-info {
      display: none !important;
    }
  }
</style>
