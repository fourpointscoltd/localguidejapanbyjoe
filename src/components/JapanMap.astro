---
import { prefectures } from '../data/prefectures';

// Approximate x,y positions for each prefecture on a 500x700 viewBox
const positions: Record<string, { x: number; y: number }> = {
  hokkaido:   { x: 380, y: 100 },
  aomori:     { x: 355, y: 195 },
  iwate:      { x: 375, y: 225 },
  miyagi:     { x: 370, y: 260 },
  akita:      { x: 340, y: 230 },
  yamagata:   { x: 345, y: 265 },
  fukushima:  { x: 355, y: 295 },
  ibaraki:    { x: 370, y: 330 },
  tochigi:    { x: 350, y: 315 },
  gunma:      { x: 330, y: 305 },
  saitama:    { x: 345, y: 340 },
  chiba:      { x: 375, y: 355 },
  tokyo:      { x: 355, y: 355 },
  kanagawa:   { x: 355, y: 370 },
  niigata:    { x: 315, y: 270 },
  toyama:     { x: 280, y: 295 },
  ishikawa:   { x: 265, y: 290 },
  fukui:      { x: 255, y: 315 },
  yamanashi:  { x: 330, y: 345 },
  nagano:     { x: 310, y: 320 },
  gifu:       { x: 275, y: 330 },
  shizuoka:   { x: 315, y: 370 },
  aichi:      { x: 280, y: 360 },
  mie:        { x: 260, y: 375 },
  shiga:      { x: 250, y: 340 },
  kyoto:      { x: 235, y: 330 },
  osaka:      { x: 240, y: 355 },
  hyogo:      { x: 220, y: 345 },
  nara:       { x: 245, y: 365 },
  wakayama:   { x: 235, y: 385 },
  tottori:    { x: 195, y: 325 },
  shimane:    { x: 170, y: 330 },
  okayama:    { x: 200, y: 345 },
  hiroshima:  { x: 175, y: 350 },
  yamaguchi:  { x: 150, y: 355 },
  tokushima:  { x: 215, y: 380 },
  kagawa:     { x: 210, y: 365 },
  ehime:      { x: 190, y: 378 },
  kochi:      { x: 195, y: 395 },
  fukuoka:    { x: 130, y: 370 },
  saga:       { x: 118, y: 378 },
  nagasaki:   { x: 105, y: 385 },
  kumamoto:   { x: 125, y: 400 },
  oita:       { x: 145, y: 385 },
  miyazaki:   { x: 145, y: 415 },
  kagoshima:  { x: 120, y: 435 },
  okinawa:    { x: 70,  y: 580 },
};

const ratingColors: Record<number, string> = {
  5: '#d4563a',
  4: '#e8a84c',
  3: '#5ba3d9',
  2: '#94a3b8',
  1: '#cbd5e1',
};
---

<div class="japan-map-container">
  <div class="map-legend">
    <h3>Rating</h3>
    <div class="legend-items">
      {[5, 4, 3, 2, 1].map(r => (
        <div class="legend-item">
          <span class="legend-dot" style={`background: ${ratingColors[r]}`}></span>
          <span class="legend-label">{'★'.repeat(r)} ({r}/5)</span>
        </div>
      ))}
    </div>
  </div>

  <div class="map-wrapper">
    <svg viewBox="0 0 500 650" class="japan-svg" xmlns="http://www.w3.org/2000/svg">
      {/* Japan outline - simplified */}
      <path class="japan-outline" d="
        M355,60 Q400,70 410,95 Q420,120 400,145 Q395,165 380,175
        Q375,185 365,190 Q380,195 390,215 Q395,240 385,260
        Q380,275 375,295 Q380,320 385,340 Q390,355 380,375
        Q370,390 355,385 Q340,380 330,370 Q320,375 310,385
        Q300,380 290,375 Q280,370 270,365 Q260,375 250,390
        Q240,400 230,395 Q220,400 210,410 Q200,405 195,395
        Q190,400 180,395 Q170,400 165,390 Q155,395 145,405
        Q135,415 125,410 Q118,420 110,430 Q105,445 115,455
        Q125,450 130,440 Q120,435 115,430
        M70,555 Q55,565 60,580 Q65,595 80,600 Q95,590 90,575 Q85,560 70,555
      " fill="none" stroke="var(--color-border, #e8e5e0)" stroke-width="1.5" />

      {prefectures.map((pref) => {
        const pos = positions[pref.id];
        if (!pos) return null;
        const color = ratingColors[pref.rating];
        const r = pref.rating >= 4 ? 12 : pref.rating >= 3 ? 9 : 7;
        return (
          <g class="map-marker" data-id={pref.id} data-name={pref.name} data-nameja={pref.nameJa} data-rating={pref.rating} data-cities={pref.cities.join(', ')} data-tip={pref.localTip}>
            <circle cx={pos.x} cy={pos.y} r={r + 3} fill={color} opacity="0.2" class="marker-glow" />
            <circle cx={pos.x} cy={pos.y} r={r} fill={color} stroke="white" stroke-width="2" class="marker-dot" />
            <text x={pos.x} y={pos.y + 1} text-anchor="middle" dominant-baseline="central" fill="white" font-size={r > 9 ? "10" : "8"} font-weight="700" class="marker-text">{pref.rating}</text>
          </g>
        );
      })}
    </svg>

    <div class="map-tooltip" id="map-tooltip">
      <div class="tooltip-header">
        <span class="tooltip-ja" id="tooltip-ja"></span>
        <span class="tooltip-name" id="tooltip-name"></span>
        <span class="tooltip-stars" id="tooltip-stars"></span>
      </div>
      <p class="tooltip-cities" id="tooltip-cities"></p>
      <p class="tooltip-tip" id="tooltip-tip"></p>
    </div>
  </div>
</div>

<script>
  const markers = document.querySelectorAll('.map-marker');
  const tooltip = document.getElementById('map-tooltip');
  const tooltipJa = document.getElementById('tooltip-ja');
  const tooltipName = document.getElementById('tooltip-name');
  const tooltipStars = document.getElementById('tooltip-stars');
  const tooltipCities = document.getElementById('tooltip-cities');
  const tooltipTip = document.getElementById('tooltip-tip');

  markers.forEach(marker => {
    marker.addEventListener('mouseenter', (e) => {
      const el = e.currentTarget as Element;
      const rating = parseInt(el.getAttribute('data-rating') || '0');
      if (tooltipJa) tooltipJa.textContent = el.getAttribute('data-nameja') || '';
      if (tooltipName) tooltipName.textContent = el.getAttribute('data-name') || '';
      if (tooltipStars) tooltipStars.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating);
      if (tooltipCities) tooltipCities.textContent = el.getAttribute('data-cities') || '';
      if (tooltipTip) tooltipTip.textContent = el.getAttribute('data-tip') || '';
      if (tooltip) tooltip.classList.add('visible');
    });

    marker.addEventListener('mousemove', (e) => {
      if (!tooltip) return;
      const mapWrapper = document.querySelector('.map-wrapper');
      if (!mapWrapper) return;
      const rect = mapWrapper.getBoundingClientRect();
      const mouseEvent = e as MouseEvent;
      let x = mouseEvent.clientX - rect.left + 16;
      let y = mouseEvent.clientY - rect.top - 8;
      if (x + 280 > rect.width) x = x - 296;
      if (y + 160 > rect.height) y = y - 160;
      tooltip.style.left = x + 'px';
      tooltip.style.top = y + 'px';
    });

    marker.addEventListener('mouseleave', () => {
      if (tooltip) tooltip.classList.remove('visible');
    });
  });
</script>

<style>
  .japan-map-container {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .map-legend {
    flex-shrink: 0;
    width: 140px;
    padding-top: 24px;
  }

  .map-legend h3 {
    font-size: 1.4rem;
    margin-bottom: 12px;
    color: var(--color-primary, #1b2d3a);
  }

  .legend-items {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-label {
    font-size: 1.2rem;
    color: var(--color-primary-text);
    white-space: nowrap;
  }

  .map-wrapper {
    position: relative;
    flex: 1;
    max-width: 600px;
  }

  .japan-svg {
    width: 100%;
    height: auto;
  }

  .map-marker {
    cursor: pointer;
    transition: transform 0.2s;
  }

  .map-marker:hover .marker-dot {
    filter: brightness(1.15);
  }

  .map-marker:hover .marker-glow {
    opacity: 0.4;
    r: 20;
  }

  .marker-glow {
    transition: opacity 0.2s, r 0.2s;
  }

  .marker-text {
    pointer-events: none;
    user-select: none;
  }

  .map-tooltip {
    position: absolute;
    background: var(--color-white, white);
    border: 1px solid var(--color-border, #e8e5e0);
    border-radius: 12px;
    padding: 16px;
    width: 280px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s, transform 0.15s;
    z-index: 100;
  }

  .map-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tooltip-header {
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .tooltip-ja {
    font-size: 1.3rem;
    color: var(--color-secondary-text, #6b7280);
  }

  .tooltip-name {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-primary, #1b2d3a);
  }

  .tooltip-stars {
    font-size: 1.3rem;
    color: var(--color-accent, #d4563a);
    letter-spacing: 1px;
  }

  .tooltip-cities {
    font-size: 1.2rem;
    color: var(--color-secondary-text, #6b7280);
    margin: 0 0 8px;
  }

  .tooltip-tip {
    font-size: 1.3rem;
    color: var(--color-primary-text, #333);
    line-height: 1.45;
    margin: 0;
    border-top: 1px solid var(--color-border, #e8e5e0);
    padding-top: 8px;
  }

  @media (max-width: 767px) {
    .japan-map-container {
      flex-direction: column;
    }

    .map-legend {
      width: 100%;
      padding-top: 0;
    }

    .legend-items {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
    }

    .map-wrapper {
      max-width: 100%;
    }

    .map-tooltip {
      display: none;
    }
  }
</style>
